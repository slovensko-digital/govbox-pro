<%= fields_for @automation_rule do |rule_form| %>
  <%= turbo_stream.append 'actions' do %>
    <%= rule_form.fields_for :actions, include_id: false, child_index: @index do |action_form| %>
      <%= render "settings/rules/actions_form_row", form: action_form, index: @index %>
    <% end %>
  <% end %>
<% end %>
<%= fields_for @new_rule do |new_rule_form| %>
  <%= turbo_stream.update 'action-new' do %>
    <%= new_rule_form.fields_for :actions, include_id: false, child_index: @index+1 do |action_form| %>
      <%= render "settings/rules/action_form", form: action_form, index: @index+1, new: true %>
    <% end %>
  <% end %>
<% end %>
