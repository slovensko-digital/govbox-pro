<div class="w-full p-4 flex-col justify-start items-start gap-4 inline-flex">
  <div class="self-stretch bg-white rounded-md border border-gray-200 flex-col justify-start items-start flex">
    <header class="self-stretch p-6 border-b border-gray-200">
      <div class="flex items-center justify-between gap-4">
        <h1 class="text-xl font-semibold leading-[35px] text-gray-900"><%= t('admin.groups.permissions.title', group_name: group.name) %></h1>
        <%= link_to admin_tenant_permissions_path(Current.tenant), class: "px-3.5 py-2.5 bg-white rounded-md border border-gray-300 justify-center items-center gap-2.5 flex hover:bg-gray-100" do %>
          <p class="text-gray-900 text-base font-medium leading-normal"><%= t('admin.groups.permissions.back') %></p>
        <% end %>
      </div>
      <div id="group-permissions" class="mt-2 flex max-w-2xl flex-col gap-4">
        <%= render "admin/permissions/permission_switch",
                   url: update_all_boxes_permission_admin_tenant_group_path(Current.tenant, group),
                   permission: :all_boxes_permission, enabled: group.all_boxes_permission?,
                   label: t('admin.groups.permissions.all_boxes_label'),
                   description: t('admin.groups.permissions.all_boxes_description') %>
        <% if group.manage_access_tags_changeable? %>
          <%= render "admin/permissions/permission_switch",
                     url: update_can_manage_access_tags_admin_tenant_group_path(Current.tenant, group),
                     permission: :can_manage_access_tags, enabled: group.can_manage_access_tags?,
                     label: t('admin.groups.permissions.access_tags_label'),
                     description: t('admin.groups.permissions.access_tags_description') %>
        <% else %>
          <div class="ps-14">
            <p class="font-medium text-gray-900"><%= t('admin.groups.permissions.access_tags_label') %></p>
            <p class="mt-1 text-sm text-gray-600"><%= t('admin.groups.permissions.access_tags_always_enabled') %></p>
          </div>
        <% end %>
      </div>
    </header>
    <div class="self-stretch p-6 border-b border-gray-200">
      <%= form_with url: search_boxes_and_tags_admin_tenant_group_path(Current.tenant, group),
                    data: { controller: 'debounce', debounce_target: 'form'},
                    class: "flex justify-start items-center self-stretch gap-4" do |form| %>
        <div class="relative w-full">
          <div class="flex w-full items-center rounded-md shadow-xs ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-600">
            <div class="p-2">
              <%= render Icons::MagnifyingGlassComponent.gray(size: "5") %>
            </div>
            <%= form.search_field :name_search, value: params[:name_search], placeholder: t('admin.groups.permissions.search_placeholder.boxes_and_tags'),
                data: { controller: 'auto-submit', action: 'input->debounce#debounce reset->auto-submit#submit' },
                autocomplete: "off",
                class: "block w-full flex-1 border-0 bg-transparent py-1.5 pl-1 text-gray-900 placeholder:text-gray-400 focus:ring-0 sm:text-sm sm:leading-6" %>
          </div>
          <%= tag.turbo_frame id:'boxes-and-tags-search-results' %>
        </div>
      <% end %>
    </div>
    <div class="self-stretch p-6 grid grid-cols-2 gap-6">
      <!-- Boxes Column -->
      <div class="flex flex-col gap-4 pb-6" id="boxes-column">
        <div class="text-lg font-semibold text-gray-900"><%= t('admin.groups.permissions.boxes') %></div>
        <div class="flex flex-col divide-y border rounded-md border-gray-200">
          <% if group.all_boxes_permission? %>
            <p class="p-4 text-sm text-gray-600 text-center"><%= t('admin.groups.permissions.all_boxes_enabled') %></p>
          <% elsif group.box_groups.empty? %>
            <div class="p-4 text-sm text-gray-500 text-center">
              <%= t('admin.groups.permissions.empty_list.box') %>
            </div>
          <% else %>
            <% group.box_groups.each do |box_group| %>
              <%= render layout: "admin/permissions/item_row", locals: {
                delete_path: admin_tenant_group_box_group_path(Current.tenant, group, box_group),
                id: dom_id(box_group.box, :permission_row)
              } do %>
                <p class="self-stretch grow-0 shrink-0 text-sm font-medium text-left text-gray-900"><%= box_group.box.name %></p>
                <p class="self-stretch grow-0 shrink-0 text-xs text-left text-gray-500"><%= box_group.box.short_name %></p>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <!-- Tags Column -->
      <div class="flex flex-col gap-4" id="tags-column">
        <div class="text-lg font-semibold text-gray-900"><%= t('admin.groups.permissions.tags') %></div>
        <div class="flex flex-col divide-y border rounded-md border-gray-200">
          <% if group.tag_groups.empty? %>
            <div class="p-4 text-sm text-gray-500 text-center">
              <%= t('admin.groups.permissions.empty_list.tag') %>
            </div>
          <% else %>
            <% group.tag_groups.each do |group_permission| %>
              <%= render layout: "admin/permissions/item_row", locals: {
                delete_path: admin_tenant_group_tag_group_path(Current.tenant, group, group_permission),
                id: dom_id(group_permission.tag, :permission_row),
                restricted: group_permission.restricted?
              } do %>
                <%= render Common::TagComponent.new(group_permission.tag) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
