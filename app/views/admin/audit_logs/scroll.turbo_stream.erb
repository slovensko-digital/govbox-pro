<%= turbo_stream.append "audit_logs" do %>
  <%= render partial: "admin/audit_logs/audit_log_table_row", collection: @audit_logs, as: :audit_log_item, locals: { view: @view } %>
<% end %>
<% if @audit_logs.any? %>
  <%= turbo_stream.append "next_page_area" do %>
    <%= render "turbo/next_page", id: @next_cursor, url: @url %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "next_page_area" %>
<% end %>
