<%# locals: (diff:) %>
<% if diff.number_of_changes > 0 %>
  <div class="text-sm w-full mx-2 mb-4">
    <p class="mb-2 italic">Po uložení sa vykonajú nasledovné zmeny:</p>
    <% if diff.to_add.present? %>
      <p class="mb-2" data-test="to_be_added">Pridajú sa: <%= signer_names(diff.to_add) %></p>
    <% end %>
    <% if diff.to_remove.present? %>
      <p class="mb-2" data-test="to_be_removed">Odoberú sa: <%= signer_names(diff.to_remove) %></p>
    <% end %>
  </div>
<% end %>
