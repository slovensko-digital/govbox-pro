<%# locals: (message_draft:, message_objects:, signers_changes:) %>
<%= render layout: "common/modal", locals: { header: "Podpisujúci" } do %>
  <%= form_with url: prepare_message_draft_signature_requests_path(message_draft) do %>
    <% message_objects.each do |message_object| %>
      <%= hidden_field_tag "object_ids[]", message_object.id %>
    <% end %>
    <div class="flex flex-col items-start gap-4 mt-4">
      <div class="w-full mb-4">
        <%= render "signing/signers_requests/list", signers_changes: signers_changes %>
      </div>
    </div>
    <%= tag.turbo_frame id: "signers-assignment-diff" %>
    <%= tag.turbo_frame id: "signers-assignment-actions" do %>
      <%= render "signing/signers_requests/actions", message_draft: message_draft, signers_changes: signers_changes %>
    <% end %>
  <% end %>
<% end %>
