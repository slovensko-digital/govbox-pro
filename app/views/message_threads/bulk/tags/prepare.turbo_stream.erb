<% if @reset_search %>
  <%= turbo_stream.update "tags-assignment-search-field" do %>
    <%= render "tags_assignment/search_field" %>
  <% end %>
<% end %>
<% if @rerender_list %>
  <%= turbo_stream.update "tags-assignment-list" do %>
    <%= render "tags_assignment/list", tags_filter: @tags_filter, tags_assignments: @tags_changes.tags_assignments, create_tag_path: create_tag_message_threads_bulk_tags_path %>
  <% end %>
<% end %>
<%= turbo_stream.update "tags-assignment-actions" do %>
  <%= render layout: "common/modal_actions" do %>
    <% if @tags_changes.number_of_changes > 0 %>
      <%= submit_tag "Uložiť zmeny (#{@tags_changes.number_of_changes})", formaction: message_threads_bulk_tags_path, formmethod: :patch, data: { turbo_frame: "_top" }, class: "inline-flex w-full justify-center items-center px-3 py-2 rounded-md bg-blue-600 font-medium text-left text-sm text-white hover:cursor-pointer sm:w-auto" %>
    <% end %>
  <% end %>
<% end %>
