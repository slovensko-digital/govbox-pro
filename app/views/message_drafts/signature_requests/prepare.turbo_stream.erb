<%= turbo_stream.update "signers-assignment-diff" do %>
  <%= render "signing/signers_requests/diff", diff: @signers_changes.diff %>
<% end %>
<%= turbo_stream.update "signers-assignment-actions" do %>
  <%= render "signing/signers_requests/actions", message_draft: @message_draft, signers_changes: @signers_changes %>
<% end %>
