<%# locals: (message_threads:, tags_changes:, tags_filter:) %>
<%= render layout: "common/modal", locals: { header: t("tag_editing_in_message_threads", count: message_threads.length) } do %>
  <%= form_with url: prepare_message_threads_bulk_tags_path,
                  data: { controller: 'debounce', debounce_target: 'form' } do |form| %>
    <% message_threads.each do |thread| %>
      <%= hidden_field_tag "message_thread_ids[]", thread.id %>
    <% end %>
    <div class="flex flex-col items-start gap-4 mt-4">
      <div class="w-full">
        <%= tag.turbo_frame id: "tags-assignment-search-field" do %>
          <%= render "tags_assignment/search_field" %>
        <% end %>
      </div>
      <div class="w-full mb-4">
        <% tags_changes.init_assignments.each do |tag_id, value| %>
          <%= hidden_field_tag "tags_assignments[init][#{tag_id}]", value %>
        <% end %>
        <%= tag.turbo_frame id: "tags-assignment-list" do %>
          <%=
              render "tags_assignment/list", tags_filter: tags_filter, tags_assignments: tags_changes.tags_assignments, create_tag_path: create_tag_message_threads_bulk_tags_path %>
        <% end %>
      </div>
    </div>
    <%= tag.turbo_frame id: "tags-assignment-actions" do %>
      <%= render "common/modal_actions" %>
    <% end %>
  <% end %>
<% end %>
