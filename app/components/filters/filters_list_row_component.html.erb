<div class="self-stretch p-6 border-b border-gray-200 justify-start items-center gap-4 flex flex-wrap" data-filter-id="<%= @filter.id %>">
  <div class="relative inline-flex items-center justify-center w-16 h-16 overflow-hidden bg-blue-600 rounded-full">
    <span class="text-white text-2xl font-normal"><%= @filter.name[0] %></span>
  </div>
  <div class="grow shrink basis-0 flex-col justify-start items-start gap-1 inline-flex">
    <div class="text-center text-gray-900 text-lg font-medium leading-loose">
      <%= link_to @filter.name, message_threads_path(q: @filter.query), class: "underline" %>
    </div>
    <div class="text-center text-gray-500 text-base font-normal leading-normal">
      <%= @filter.query %>
    </div>
    <p class="text-sm text-gray-500"><%= @filter.common? ? "Spoločný filter" : "Osobný filter" %></p>
    <% if @subscriptions.any? %>
      <p class="text-sm text-gray-500">Notifikácie zapnuté</p>
      <% @subscriptions.each do |subscription| %>
        <%= link_to "Nastaviť notifikácie", edit_filter_filter_subscription_path(subscription.filter, subscription), data: { turbo_frame: "modal" }, class: "underline text-sm", aria: { label: "Nastaviť notifikácie: #{subscription.filter.name}" } %>
      <% end %>
    <% else %>
      <%= link_to "Nastaviť notifikácie", new_filter_filter_subscription_path(@filter), data: { turbo_frame: "modal" }, class: "underline text-sm" %>
    <% end %>
  </div>
  <div class="justify-start items-center gap-2 flex flex-wrap">
    <% if @overridden %>
      <span class="text-sm text-gray-500">Prekrytý osobným filtrom</span>
    <% else %>
      <% pinned = @preference&.visible? || false %>
      <% pin_path = @preference ? settings_user_filter_visibility_path(@preference) : settings_user_filter_visibilities_path %>
      <% pin_method = @preference ? :patch : :post %>
      <% pin_params = @preference ? { user_filter_visibility: { visible: !pinned } } : { user_filter_visibility: { filter_id: @filter.id, visible: true } } %>
      <%= button_to pin_path, method: pin_method, params: pin_params,
        title: pinned ? "Pripnuté" : "Odopnuté",
        aria: { label: "#{pinned ? 'Odopnúť' : 'Pripnúť'}: #{@filter.name}", pressed: pinned },
        class: "flex items-center justify-center rounded-md border p-2 transition-colors #{pinned ? 'border-indigo-300 bg-indigo-50 text-indigo-700 hover:bg-indigo-100' : 'border-gray-300 bg-white text-gray-500 hover:bg-gray-50 hover:text-gray-800'}" do %>
        <%= render Icons::BookmarkComponent.new(css_classes: "h-5 w-5 #{pinned ? 'fill-current' : 'fill-none'}") %>
        <span class="sr-only"><%= pinned ? "Pripnuté" : "Odopnuté" %></span>
      <% end %>
      <% if pinned %>
        <%= button_to move_higher_settings_user_filter_visibility_path(@preference), method: :post, aria: { label: "Posunúť vyššie: #{@filter.name}" }, class: "rounded-md border border-gray-300 p-2" do %>
          <%= render Common::IconComponent.new("chevron-up") %>
        <% end %>
        <%= button_to move_lower_settings_user_filter_visibility_path(@preference), method: :post, aria: { label: "Posunúť nižšie: #{@filter.name}" }, class: "rounded-md border border-gray-300 p-2" do %>
          <%= render Common::IconComponent.new("chevron-down") %>
        <% end %>
      <% end %>
    <% end %>
    <% if helpers.policy(@filter).edit? %>
      <%= link_to edit_filter_path(@filter), title: "Upraviť filter" do %>
        <%= render Common::EditButtonComponent.new %>
      <% end %>
      <%= link_to(@filter.common? ? confirm_destroy_filter_path(@filter) : filter_path(@filter), title: "Zmazať filter", data: @filter.common? ? {} : { turbo_confirm: "Naozaj?", turbo_method: :delete }) do %>
        <%= render Common::DeleteButtonComponent.new %>
      <% end %>
    <% end %>
  </div>
</div>
