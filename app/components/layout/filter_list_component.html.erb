<% if @filters.present? %>
  <div class="flex flex-col justify-start items-start gap-2" data-test="filters">
    <% if @show_heading %>
      <div class="flex justify-start items-start px-4 py-2">
        <p class="text-sm text-center text-gray-400">Filtre</p>
      </div>
    <% end %>
    <% @filters.each do |filter| %>
      <% url = message_threads_path(q: filter.query) %>
      <%= link_to url, class: "text-gray-700 hover:text-indigo-600 hover:bg-gray-50 group w-72 flex gap-x-3 rounded-md p-2 px-4 text-sm leading-6 font-semibold data-[active=true]:bg-gray-50 data-[active=true]:text-indigo-600", data: { active: @query.nil? ? current_page?(url) : @query == filter.query } do %>
        <% if filter.tag %>
          <% icon_classes = "w-6 h-6 shrink-0 text-#{filter.tag.color || 'gray'}-600" %>
          <% if filter.tag.error? %>
            <%= render Common::IconComponent.new(filter.tag.icon, classes: icon_classes) %>
          <% else %>
            <%= render Icons::TagComponent.new(css_classes: icon_classes) %>
          <% end %>
        <% else %>
          <%= render Icons::BookmarkComponent.new(css_classes: "w-6 h-6 text-gray-600") %>
        <% end %>
        <p class="truncate text-base font-medium"><%= filter.name %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
