<div class="w-full p-4 flex-col justify-start items-start gap-4 inline-flex" data-test="my-menu-settings">
  <div class="self-stretch bg-white rounded-md border border-gray-200 flex-col justify-start items-start flex">
    <div class="self-stretch p-6 border-b border-gray-200">
      <h1 class="text-gray-900 text-xl font-semibold leading-[35px]">Moje menu</h1>
      <p class="mt-1 text-sm text-gray-500">Vyberte filtre, ktoré chcete mať v bočnom menu, a upravte ich poradie. Toto nastavenie nemení štítky na správach ani odbery notifikácií.</p>
    </div>
    <div class="self-stretch flex-col justify-start items-start flex">
      <% @filters.each do |filter| %>
        <%= render Settings::UserFilterVisibilities::ListRowComponent.new(filter: filter, preference: @preferences[filter.id]) %>
      <% end %>
    </div>
  </div>
</div>
