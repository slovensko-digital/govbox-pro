# Environment files
.env*

# Local secrets
/config/master.key
/config/credentials/*.key

# Bundler state, logs and temp files
/.bundle
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Local storage and built assets (rebuilt during the image build)
/storage/*
!/storage/.keep
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

.erb-lint.yml
.git/
.gitattributes
.github/
.gitignore
.gitlab-ci.yml
.gitlab/
.rubocop.yml
.ruby-lsp
.vscode/
node_modules/
Procfile
Procfile.debug
Procfile.dev
